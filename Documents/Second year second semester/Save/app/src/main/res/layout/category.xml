<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#C2E29C">

    <LinearLayout
        android:id="@+id/linearLayout9"
        android:layout_width="222dp"
        android:layout_height="1449dp"
        android:background="#EBEDEA"
        android:backgroundTint="#EEF2EB"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">

    </LinearLayout>

    <ScrollView
        android:layout_width="339dp"
        android:layout_height="477dp"
        android:layout_marginTop="500dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.225">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imageView9"
                android:layout_width="171dp"
                android:layout_height="197dp"
                android:layout_weight="1"
                app:srcCompat="@drawable/category2" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="176dp"
                android:layout_height="71dp"
                android:text="Category"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imageView16"
                android:layout_width="176dp"
                android:layout_height="144dp"
                app:srcCompat="@drawable/accounting" />

            <TextView
                android:id="@+id/textView4"
                android:layout_width="176dp"
                android:layout_height="63dp"
                android:text="Accounts"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imageView17"
                android:layout_width="172dp"
                android:layout_height="136dp"
                app:srcCompat="@drawable/settings" />

            <TextView
                android:id="@+id/textView5"
                android:layout_width="172dp"
                android:layout_height="80dp"
                android:text="Settings"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imageView18"
                android:layout_width="180dp"
                android:layout_height="168dp"
                app:srcCompat="@drawable/currency" />

            <TextView
                android:id="@+id/textView17"
                android:layout_width="192dp"
                android:layout_height="76dp"
                android:layout_weight="1"
                android:text="Currency"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imageView20"
                android:layout_width="211dp"
                android:layout_height="261dp"
                android:layout_weight="1"
                app:srcCompat="@drawable/choose" />

            <TextView
                android:id="@+id/textView18"
                android:layout_width="272dp"
                android:layout_height="115dp"
                android:layout_weight="1"
                android:text="ChooseDAte"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imageView21"
                android:layout_width="253dp"
                android:layout_height="267dp"
                android:layout_weight="1"
                app:srcCompat="@drawable/user" />

            <TextView
                android:id="@+id/textView6"
                android:layout_width="272dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                android:backgroundTint="#8BC34A"
                android:text="Profile"
                android:textSize="34sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>